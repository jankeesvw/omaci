pkgname=omaci
pkgver=0.4.1
pkgrel=1
pkgdesc='The builds of one repository, live: how far, how long still, and what failed'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
optdepends=('github-cli: talks to GitHub (any gh on PATH or in mise works too)'
            'libnotify: desktop notifications when a build finishes')
makedepends=('gcc' 'make')
# It was called ciwatch, and the GitHub Build Monitor widget still starts it
# by that name.
provides=('ciwatch')
conflicts=('ciwatch')
replaces=('ciwatch')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/omaci "$pkgdir/usr/bin/omaci"
  ln -s omaci "$pkgdir/usr/bin/ciwatch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/omaci.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omaci.svg"
  install -Dm644 "$startdir/omaci.desktop" "$pkgdir/usr/share/applications/omaci.desktop"
}
